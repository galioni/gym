# ── Client runtime (Vite, required) ─────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-publishable-key>
VITE_SUPABASE_REDIRECT_URL=http://localhost:3000
VITE_SYNC_API_BASE_URL=http://localhost:3000

# ── API runtime (required) ───────────────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<same-as-vite-supabase-anon-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>         # Project Settings → API → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>  # Project Settings → API → service_role

# Upstash KV (Vercel integration writes STORAGE_KV_* names; raw names also accepted)
STORAGE_KV_REST_API_URL=<upstash-rest-api-url>
STORAGE_KV_REST_API_TOKEN=<upstash-rest-api-token>

# AI provider — set one key depending on which provider you use
AI_PROVIDER=google                                # openai | anthropic | google (default: google)
AI_MODEL=gpt-4o-mini                              # optional — defaults to provider's recommended model
OPENAI_API_KEY=<openai-api-key>                   # platform.openai.com → API keys
ANTHROPIC_API_KEY=<anthropic-api-key>             # console.anthropic.com → API keys
GOOGLE_GENERATIVE_AI_API_KEY=<google-api-key>     # aistudio.google.com → API keys

# Stripe
STRIPE_SECRET_KEY=<stripe-secret-key>             # Stripe dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>  # Stripe → Developers → Webhooks → endpoint
STRIPE_PRO_PRICE_ID=<stripe-price-id>             # Stripe → Products → Pro plan price ID (price_...)

# ── API runtime (optional) ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# ── Intentionally excluded ───────────────────────────────────────────────────
# VERCEL_OIDC_TOKEN, POSTGRES_* — managed by Vercel integration, not set manually
