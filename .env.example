# Client runtime (required)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-publishable-key>
VITE_SUPABASE_REDIRECT_URL=http://localhost:5173
VITE_SYNC_API_BASE_URL=https://<your-vercel-domain>

# API runtime (required)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<same-as-vite-supabase-anon-key>
KV_REST_API_URL=<upstash-rest-api-url>
KV_REST_API_TOKEN=<upstash-rest-api-token>

# API runtime (optional)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-vercel-domain>

# Intentionally excluded from local app runtime:
# - SUPABASE_SERVICE_ROLE_KEY
# - SUPABASE_SECRET_KEY
# - SUPABASE_JWT_SECRET
# - VERCEL_OIDC_TOKEN
# - POSTGRES_*
