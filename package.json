{
  "name": "daily-workout-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && ANALYZE=1 vite build",
    "preview": "vite preview",
    "qa:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "husky",
    "gym:init": "node scripts/local/gym.mjs init",
    "gym:up": "node scripts/local/gym.mjs up",
    "gym:down": "node scripts/local/gym.mjs down",
    "gym:reset": "node scripts/local/gym.mjs reset",
    "gym:migrate": "node scripts/local/gym.mjs migrate",
    "gym:test-db": "node scripts/local/gym.mjs test-db",
    "gym:test-sync": "node scripts/local/gym.mjs test-sync",
    "gym:psql": "node scripts/local/gym.mjs psql",
    "gym:seed": "node scripts/local/gym.mjs seed",
    "gym:ps": "node scripts/local/gym.mjs ps",
    "gym:logs": "node scripts/local/gym.mjs logs",
    "gym:restart": "node scripts/local/gym.mjs restart"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.114",
    "@ai-sdk/google": "^3.0.118",
    "@ai-sdk/openai": "^3.0.104",
    "@supabase/auth-js": "^2.112.4",
    "@supabase/postgrest-js": "^2.117.2",
    "@supabase/realtime-js": "^2.112.4",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.271",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
